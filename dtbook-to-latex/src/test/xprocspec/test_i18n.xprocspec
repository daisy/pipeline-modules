<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.daisy.org/ns/xprocspec"
               xmlns:pxi="http://www.daisy.org/ns/pipeline/xproc/internal"
               xmlns="http://www.daisy.org/z3986/2005/dtbook/">

  <x:documentation xmlns="http://www.w3.org/1999/xhtml">
    <p>The words and phrases that the conversion generates itself are translated with the
    translations in <code>i18n.xml</code>.</p>
  </x:documentation>

  <x:script>
    <p:declare-step type="pxi:dtbook-to-latex" version="1.0"
                    xmlns:p="http://www.w3.org/ns/xproc" name="main">
      <p:input port="source" primary="true"/>
      <p:input port="parameters" kind="parameter" primary="true"/>
      <p:output port="result" primary="true"/>
      <p:xslt>
        <p:input port="stylesheet">
          <p:document href="../../main/resources/xml/dtbook-to-latex.xsl"/>
        </p:input>
        <p:input port="parameters">
          <p:pipe step="main" port="parameters"/>
        </p:input>
      </p:xslt>
    </p:declare-step>
  </x:script>

  <x:scenario label="an English book of three volumes">
    <x:call step="pxi:dtbook-to-latex">
      <x:input port="source">
        <x:document type="inline">
          <dtbook version="2005-3" xml:lang="en">
            <head>
              <meta name="dc:title" content="A book"/>
            </head>
            <book>
              <frontmatter>
                <doctitle>A book</doctitle>
              </frontmatter>
              <bodymatter>
                <level1>
                  <h1>Heading</h1>
                  <p>one</p>
                  <p class="volume-split-point">two</p>
                  <p class="volume-split-point">three</p>
                </level1>
              </bodymatter>
            </book>
          </dtbook>
        </x:document>
      </x:input>
    </x:call>
    <x:context label="result">
      <x:document type="port" port="result"/>
    </x:context>
    <x:expect label="the number of volumes is written out in words" type="xpath"
              test="contains(string(/),'Large print book in three volumes')"/>
    <x:expect label="the volumes are numbered" type="xpath"
              test="contains(string(/),'Volume 1 of 3') and contains(string(/),'Volume 2 of 3')"/>
    <x:expect label="the notes are called Notes" type="xpath"
              test="contains(string(/),'\renewcommand*{\notesname}{Notes}')"/>
  </x:scenario>

  <x:scenario label="a German book of three volumes">
    <x:call step="pxi:dtbook-to-latex">
      <x:input port="source">
        <x:document type="inline">
          <dtbook version="2005-3" xml:lang="de">
            <head>
              <meta name="dc:title" content="Ein Buch"/>
            </head>
            <book>
              <frontmatter>
                <doctitle>Ein Buch</doctitle>
              </frontmatter>
              <bodymatter>
                <level1>
                  <h1>Überschrift</h1>
                  <p>eins</p>
                  <p class="volume-split-point">zwei</p>
                  <p class="volume-split-point">drei</p>
                </level1>
              </bodymatter>
            </book>
          </dtbook>
        </x:document>
      </x:input>
    </x:call>
    <x:context label="result">
      <x:document type="port" port="result"/>
    </x:context>
    <x:expect label="the number of volumes is written out in German" type="xpath"
              test="contains(string(/),'Großdruck in drei Bänden')"/>
    <x:expect label="the volumes are numbered in German" type="xpath"
              test="contains(string(/),'Band 1 von 3')"/>
    <x:expect label="the notes are called Anmerkungen" type="xpath"
              test="contains(string(/),'\renewcommand*{\notesname}{Anmerkungen}')"/>
  </x:scenario>

  <x:scenario label="a Swiss German book">
    <x:documentation xmlns="http://www.w3.org/1999/xhtml">
      <p>Swiss German only overrides the strings that are spelled with "ss" instead of "ß", the
      rest falls back to German.</p>
    </x:documentation>
    <x:call step="pxi:dtbook-to-latex">
      <x:input port="source">
        <x:document type="inline">
          <dtbook version="2005-3" xml:lang="de-CH">
            <head>
              <meta name="dc:title" content="Ein Buch"/>
            </head>
            <book>
              <frontmatter>
                <doctitle>Ein Buch</doctitle>
              </frontmatter>
              <bodymatter>
                <level1>
                  <h1>Überschrift</h1>
                  <p>eins</p>
                  <p class="volume-split-point">zwei</p>
                </level1>
              </bodymatter>
            </book>
          </dtbook>
        </x:document>
      </x:input>
    </x:call>
    <x:context label="result">
      <x:document type="port" port="result"/>
    </x:context>
    <x:expect label="the book is a Grossdruck rather than a Großdruck" type="xpath"
              test="contains(string(/),'Grossdruck in zwei Bänden')"/>
    <x:expect label="and the volume numbering falls back to German" type="xpath"
              test="contains(string(/),'Band 1 von 2')"/>
  </x:scenario>

  <x:scenario label="a single volume">
    <x:call step="pxi:dtbook-to-latex">
      <x:input port="source">
        <x:document type="inline">
          <dtbook version="2005-3" xml:lang="de">
            <head>
              <meta name="dc:title" content="Ein Buch"/>
            </head>
            <book>
              <frontmatter>
                <doctitle>Ein Buch</doctitle>
              </frontmatter>
              <bodymatter>
                <level1>
                  <h1>Überschrift</h1>
                  <p>eins</p>
                </level1>
              </bodymatter>
            </book>
          </dtbook>
        </x:document>
      </x:input>
    </x:call>
    <x:context label="result">
      <x:document type="port" port="result"/>
    </x:context>
    <x:expect label="is in the dative, which is why the singular carries no number" type="xpath"
              test="contains(string(/),'Großdruck in einem Band')"/>
    <x:expect label="and is not numbered on the cover" type="xpath"
              test="not(contains(string(/),'Band 1 von 1'))"/>
  </x:scenario>

  <x:scenario label="a language without translations">
    <x:documentation xmlns="http://www.w3.org/1999/xhtml">
      <p>Swedish has no translations, so the phrases fall back to another language, but the number
      of volumes falls back to the digit rather than to an English number word.</p>
    </x:documentation>
    <x:call step="pxi:dtbook-to-latex">
      <x:input port="source">
        <x:document type="inline">
          <dtbook version="2005-3" xml:lang="sv">
            <head>
              <meta name="dc:title" content="En bok"/>
            </head>
            <book>
              <frontmatter>
                <doctitle>En bok</doctitle>
              </frontmatter>
              <bodymatter>
                <level1>
                  <h1>Rubrik</h1>
                  <p>ett</p>
                  <p class="volume-split-point">två</p>
                  <p class="volume-split-point">tre</p>
                </level1>
              </bodymatter>
            </book>
          </dtbook>
        </x:document>
      </x:input>
    </x:call>
    <x:context label="result">
      <x:document type="port" port="result"/>
    </x:context>
    <x:expect label="the number of volumes is a digit" type="xpath"
              test="contains(string(/),'in 3 volumes')"/>
    <x:expect label="and not an English number word" type="xpath"
              test="not(contains(string(/),'in three volumes'))"/>
  </x:scenario>

</x:description>
